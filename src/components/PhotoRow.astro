---
import type { ImageMetadata } from 'astro';
import { Picture, getImage } from 'astro:assets';

interface Props {
  images: { src: ImageMetadata; alt: string }[];
  caption?: string;
  eager?: boolean;
}

const { images, caption, eager = false } = Astro.props;
const items = await Promise.all(
  images.map(async ({ src, alt }) => {
    const full = await getImage({ src, width: Math.min(src.width, 2400), format: 'webp' });
    const w = Number(full.attributes.width ?? src.width);
    return { src, alt, href: full.src, w, h: Math.round((w / src.width) * src.height) };
  }),
);
const cols = { 1: 'grid-cols-1', 2: 'grid-cols-2', 3: 'grid-cols-3' }[Math.min(items.length, 3)];
---

<figure class="not-prose my-8 md:my-10">
  <div class:list={['pswp-gallery grid gap-1', cols]}>
    {
      items.map((item) => (
        <a href={item.href} data-pswp-width={item.w} data-pswp-height={item.h} target="_blank" class="block bg-neutral-100">
          <Picture
            src={item.src}
            alt={item.alt}
            formats={['avif', 'webp']}
            widths={[240, 340, 480, 680]}
            sizes={`(min-width: 720px) ${Math.round(680 / items.length)}px, ${Math.round(100 / items.length)}vw`}
            loading={eager ? 'eager' : 'lazy'}
            class="aspect-[2/3] h-full w-full object-cover"
          />
        </a>
      ))
    }
  </div>
  {caption && <figcaption class="text-muted mt-3 font-sans text-[15px] leading-snug">{caption}</figcaption>}
</figure>

---
import '@fontsource-variable/onest';
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/source-serif-4/wght-italic.css';
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import type { ComponentProps } from 'astro/types';
import { SITE } from '../site';

type Props = ComponentProps<typeof Seo>;
const props = Astro.props;
// Адреса с учётом base (сайт живёт в подпапке на GitHub Pages)
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    <meta name="generator" content={Astro.generator} />
    <Seo {...props} />
  </head>
  <body class="min-h-dvh font-sans antialiased">
    <slot />
    <script>
      import '../scripts/lightbox';
    </script>
    {
      SITE.cfAnalyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: SITE.cfAnalyticsToken })}
        />
      )
    }
  </body>
</html>
